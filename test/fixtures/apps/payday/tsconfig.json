{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@mistriwork/mistri/commands": ["../../../../packages/mistri/src/server/commands.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
