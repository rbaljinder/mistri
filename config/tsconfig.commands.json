{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "removeComments": false,
    "paths": {
      "@mistriwork/ui/behaviors/index.js": ["../packages/mistri/schema/behaviors.d.ts"]
    }
  },
  "include": [
    "../packages/engine/src",
    "../packages/kit/src",
    "../packages/mistri/src/server/commands.ts",
    "../packages/mistri/src/server/policy.ts",
    "../packages/mistri/src/server/maintenance.ts",
    "../packages/mistri/src/server/jobs.ts",
    "../packages/mistri/src/server/workflows.ts",
    "../packages/mistri/src/server/agents.ts",
    "../packages/mistri/src/server/integration.ts",
    "../packages/mistri/src/server/openfeature.ts",
    "../packages/mistri/src/server/testing.ts",
    "../packages/mistri/src/server/handler.ts",
    "../packages/ui/src",
    "../packages/cloudflare/src"
  ],
  "exclude": [
    "../packages/*/src/client",
    "../packages/*/src/embed",
    "../packages/*/src/**/*.test.ts",
    "../packages/*/src/**/*.test.tsx",
    "../packages/ui/src/behaviors"
  ]
}
