{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@mistriwork/mistri/commands": ["../../../packages/mistri/src/server/commands.ts"],
      "@mistriwork/mistri/policy": ["../../../packages/mistri/src/server/policy.ts"],
      "@mistriwork/mistri/jobs": ["../../../packages/mistri/src/server/jobs.ts"],
      "@mistriwork/mistri/workflows": ["../../../packages/mistri/src/server/workflows.ts"],
      "@mistriwork/mistri/testing": ["../../../packages/mistri/src/server/testing.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts"]
}
