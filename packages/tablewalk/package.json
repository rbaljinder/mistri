{
  "name": "tablewalk",
  "version": "1.0.0-rc.1",
  "description": "Follow the data. A database browser built around the walk: a foreign key is a place you can go.",
  "keywords": [
    "browser",
    "cli",
    "database",
    "mariadb",
    "mysql",
    "openapi",
    "postgres",
    "rest",
    "schema",
    "sqlite"
  ],
  "homepage": "https://tablewalk.dev",
  "bugs": {
    "url": "https://github.com/rbaljinder/mistri/issues"
  },
  "license": "MIT",
  "author": "Baljinder Randhawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbaljinder/mistri.git",
    "directory": "packages/tablewalk"
  },
  "bin": {
    "tablewalk": "dist/server/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "mistri-built": "./dist/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs",
    "prepack": "node ../../scripts/pack-manifest.mjs strip",
    "postpack": "node ../../scripts/pack-manifest.mjs restore"
  },
  "dependencies": {
    "@mistriwork/engine": "1.0.0-rc.1",
    "@mistriwork/kit": "1.0.0-rc.1",
    "@mistriwork/ui": "1.0.0-rc.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
