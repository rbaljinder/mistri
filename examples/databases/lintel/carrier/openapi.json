{
  "openapi": "3.1.0",
  "info": {
    "title": "Northbound Freight Tracking API",
    "version": "1.0.0",
    "description": "A made-up freight carrier's tracking API, served locally by api.mjs for Lintel's storeroom deliveries."
  },
  "servers": [{ "url": "http://127.0.0.1:4782/v1" }],
  "paths": {
    "/shipments": {
      "get": {
        "summary": "Shipments, soonest due first",
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
          { "name": "q", "in": "query", "description": "Tracking number or scan location, any part of it", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ShipmentStatus" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["eta", "-eta", "-last_scan_at"] } }
        ],
        "responses": {
          "200": {
            "description": "A page of shipments",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Shipment" } } } }
          }
        }
      }
    },
    "/shipments/{tracking_number}": {
      "get": {
        "summary": "One shipment",
        "parameters": [{ "name": "tracking_number", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "The shipment",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Shipment" } } }
          },
          "404": { "description": "No shipment with that tracking number" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShipmentStatus": {
        "type": "string",
        "enum": ["label_created", "in_transit", "out_for_delivery", "delivered", "exception"]
      },
      "Shipment": {
        "type": "object",
        "required": ["tracking_number", "status", "service"],
        "properties": {
          "tracking_number": { "type": "string", "readOnly": true, "description": "The carrier's tracking number" },
          "status": { "$ref": "#/components/schemas/ShipmentStatus" },
          "service": { "type": "string", "enum": ["ground", "expedited", "freight"] },
          "origin_city": { "type": "string" },
          "origin_state": { "type": "string" },
          "eta": { "type": "string", "format": "date", "description": "The carrier's estimated delivery day" },
          "last_scan_location": { "type": "string", "description": "Where the parcel was last scanned" },
          "last_scan_at": { "type": "string", "format": "date-time", "description": "When it was last scanned" },
          "delivered_at": { "type": ["string", "null"], "format": "date-time" },
          "signed_by": { "type": ["string", "null"] },
          "exception_reason": { "type": ["string", "null"], "description": "Why it is held, when it is" }
        }
      }
    }
  }
}
