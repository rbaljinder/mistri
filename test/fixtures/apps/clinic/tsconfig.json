{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@mistriwork/mistri/commands": ["../../../../packages/mistri/src/server/commands.ts"],
      "@mistriwork/mistri/policy": ["../../../../packages/mistri/src/server/policy.ts"]
    }
  },
  "include": ["**/*.ts"]
}
