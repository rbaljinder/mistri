---
/* A short cut from a sample App beside the screen it draws. The screen
   takes the larger share: the point is how little code it took. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
}
const { src, alt, title } = Astro.props;
---

<section class="tw-pair not-content">
  <div class="tw-pair-code">
    <h3>{title}</h3>
    <slot />
  </div>
  <div class="tw-window tw-pair-shot">
    <Image {src} {alt} sizes="(min-width: 76rem) 41rem, (min-width: 75rem) 58vw, calc(100vw - 2rem)" loading="lazy" />
  </div>
</section>
