// A Worker in front of one always-awake mistri App container. A template: copy this folder into the App's
// project as ./cloudflare, generate the image's Dockerfile at the project root, and deploy from here.
//
//   npx @mistriwork/mistri build --app my-app --config mistri.json --dockerfile Dockerfile
//   cd cloudflare && npm install && npx wrangler deploy
{
  "name": "my-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The Worker answers on the custom domain; the container never has a public address of its own.
  "routes": [{ "pattern": "app.example.com", "custom_domain": true }],

  // A sleeping instance runs no jobs, effects or mail, so this wakes every instance each minute (src/index.ts).
  // It is also why `sleepAfter` can stay short: the cron is what keeps an App's background loops running.
  "triggers": { "crons": ["* * * * *"] },

  "containers": [
    {
      "class_name": "App",
      // The Dockerfile `mistri build --dockerfile` wrote, built with the project root as its context.
      // Cloudflare has accepted only linux/amd64 images.
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      // Keep this equal to INSTANCES in src/index.ts. Cloudflare does not autoscale: N is a number you choose.
      "max_instances": 1,
      // The instance sits near the database, not the visitor: a page is several PostgreSQL round trips.
      // ENAM suits PlanetScale us-east-1; name the region of your own database.
      "constraints": { "regions": ["ENAM"] }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "App" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }],

  // Not secret: the address people use, and who may be named in a Host header.
  "vars": {
    "MISTRI_PUBLIC_URL": "https://app.example.com",
    "MISTRI_ALLOWED_HOSTS": "app.example.com",
    "MISTRI_POOLER": "transaction"
  },
  "observability": { "enabled": true }
}
// Secrets, once, with `npx wrangler secret put <NAME>`: BETTER_AUTH_SECRET and every ${NAME} the baked
// mistri.json reads (APP_DB_PASSWORD, ...). src/index.ts passes them to the container by name.
