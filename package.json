{
  "name": "mistri-workspace",
  "version": "1.0.0-rc.27",
  "private": true,
  "description": "The workspace root: the packages under packages/ (mistri, create-mistri, @mistriwork/cloudflare, @mistriwork/kit, @mistriwork/ui, @mistriwork/engine), their tests, the site and the tools. Nothing here is published.",
  "license": "MIT",
  "author": "Baljinder Randhawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbaljinder/mistri.git"
  },
  "workspaces": [
    "packages/engine",
    "packages/ui",
    "packages/kit",
    "packages/mistri",
    "packages/create-mistri",
    "packages/cloudflare"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'packages/*/src/client/**' packages/mistri/src/server/index.ts --dev",
    "start": "tsx packages/mistri/src/server/index.ts",
    "test": "npm run test:static && npm run test:node && vitest run",
    "test:ci-parity": "node scripts/ci-parity.mjs",
    "test:static": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit && oxlint && node --max-old-space-size=4096 test/check-client-types.mjs && node test/check-client-geometry.mjs && node test/check-client-motion.mjs && node test/check-client-host.mjs && node test/check-client-shape.mjs && node test/check-client-type.mjs && node test/check-client-space.mjs && node test/check-client-copy.mjs && node scripts/audit-exports.mjs && node scripts/check-boundary.mjs --entries && knip --no-progress && npm run format:check",
    "test:node": "node scripts/test-node.mjs",
    "typecheck": "tsc --noEmit",
    "test:exports": "node scripts/prove-exports.mjs",
    "build": "node scripts/build-packages.mjs && node scripts/bundle-budget.mjs && node --conditions=mistri-built scripts/type-budget.mjs",
    "build:site": "astro build --root ./site && npm --prefix storybook run build",
    "dev:site": "cd site && astro dev --host 127.0.0.1 --port 4715",
    "preview:site": "cd site && astro preview --host 127.0.0.1 --port 4715",
    "test:site:browser": "node test/site-browser.mjs",
    "test:built:browser": "node test/built-client-browser.mjs",
    "test:built:vitals": "node test/built-client-vitals.mjs",
    "test:load": "node test/load/run.mjs",
    "test:load:smoke": "node test/load/run.mjs --smoke",
    "e2e": "node scripts/test-e2e.mjs",
    "lint": "oxlint",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seed:live": "tsx test/seed-live.ts",
    "smoke": "playwright test e2e/smoke-mistri.spec.ts",
    "test:tokens": "node scripts/visual-matrix.mjs --tokens",
    "affected": "node scripts/affected.mjs",
    "test:components": "vitest run",
    "format": "oxfmt \"{packages,test,e2e,scripts,storybook,site,examples,packs}/**/*.{ts,tsx,js,mjs,cjs,mts}\" \"{*,config/*}.{ts,mjs,js,cjs,mts}\"",
    "format:check": "oxfmt --check \"{packages,test,e2e,scripts,storybook,site,examples,packs}/**/*.{ts,tsx,js,mjs,cjs,mts}\" \"{*,config/*}.{ts,mjs,js,cjs,mts}\""
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.0",
    "@axe-core/playwright": "^4.13.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "1.7.10",
    "@better-auth/scim": "1.7.10",
    "@better-auth/sso": "1.7.10",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "astro": "7.4.2",
    "better-auth": "1.7.10",
    "happy-dom": "^21.0.4",
    "intl-messageformat": "12.1.2",
    "knip": "^6.39.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "0.33.5",
    "sharp": "0.35.5",
    "starlight-links-validator": "^0.26.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "scripts/**/*.{mjs,js}",
          "test/**/*.{ts,mjs}",
          "test/fixtures/**/*.{tsx,d.mts}",
          "test/fixtures/theme-package/theme.js",
          "e2e/**/*.{ts,mjs}",
          "e2e/support/embed-react-host/main.tsx",
          "e2e/support/embed-headless-host/main.tsx",
          "e2e/support/uiMarkup.tsx",
          "examples/**/*.{ts,tsx,mjs,d.mts}",
          "packs/*/src/index.ts",
          "storybook/**/*.{ts,tsx,mjs}",
          "site/astro.config.mjs",
          "vite*.config.ts",
          "config/vite*.config.ts"
        ],
        "ignore": [
          "examples/embed/**"
        ],
        "project": [
          "scripts/**",
          "test/**",
          "e2e/**",
          "examples/**",
          "packs/**",
          "storybook/**"
        ],
        "ignoreDependencies": [
          "playwright",
          "satori",
          "@resvg/resvg-js",
          "github-slugger",
          "@storybook/react-vite",
          "storybook",
          "rolldown",
          "next",
          "react-router",
          "@tanstack/react-router",
          "postcss",
          "@tanstack/react-form",
          "@tanstack/react-table",
          "@tanstack/react-virtual",
          "@tiptap/core",
          "@tiptap/extension-image",
          "@tiptap/extension-list",
          "@tiptap/extension-mention",
          "@tiptap/extension-table",
          "@tiptap/extensions",
          "@tiptap/pm",
          "@tiptap/react",
          "@tiptap/starter-kit",
          "@tiptap/suggestion"
        ]
      },
      "packages/engine": {
        "entry": [
          "schema/*.d.ts"
        ],
        "project": [
          "src/**",
          "schema/**"
        ],
        "includeEntryExports": true
      },
      "packages/ui": {
        "project": [
          "src/**"
        ],
        "ignoreDependencies": [
          "@base-ui/react",
          "react"
        ]
      },
      "packages/kit": {
        "entry": [
          "src/client/index.html",
          "src/client/devtoolsEventClient.js"
        ],
        "project": [
          "src/**"
        ],
        "ignoreDependencies": [
          "@base-ui/react",
          "@tanstack/react-form",
          "@tanstack/react-query",
          "@tanstack/react-table",
          "@tanstack/react-virtual",
          "@tiptap/extension-image",
          "@tiptap/extension-list",
          "@tiptap/extension-mention",
          "@tiptap/extension-table",
          "@tiptap/extensions",
          "@tiptap/react",
          "@tiptap/starter-kit",
          "@tiptap/suggestion",
          "@vitejs/plugin-react",
          "react",
          "react-dom",
          "vite"
        ],
        "includeEntryExports": true
      },
      "packages/cloudflare": {
        "project": [
          "src/**"
        ]
      },
      "packages/create-mistri": {
        "ignoreDependencies": [
          "@mistriwork/mistri"
        ]
      },
      "packages/mistri": {
        "entry": [
          "src/server/{commands,policy,openfeature,maintenance,jobs,workflows,handler,integration}.ts",
          "src/client/observe/main.tsx",
          "src/client/observe/index.html",
          "src/client/components/sdk/{index.ts,testing.tsx,page.tsx}",
          "src/embed/{index.tsx,next.ts,react-router.ts,tanstack-router.ts}",
          "src/client/ssr/{render.tsx,addressMount.server.ts}",
          "src/client/components/console/*Room.tsx",
          "schema/*.{mjs,d.ts}"
        ],
        "project": [
          "src/**",
          "schema/**"
        ],
        "ignoreDependencies": [
          "oxfmt"
        ],
        "includeEntryExports": true
      }
    },
    "ignoreBinaries": [
      "mistri",
      "pg_dump",
      "mkfifo"
    ],
    "ignoreUnresolved": [
      "^/[\\w.]+\\.(js|ts)$"
    ],
    "rules": {
      "duplicates": "off"
    },
    "ignoreIssues": {
      "packages/*/schema/**": [
        "exports",
        "types"
      ],
      "packages/mistri/src/client/components/console/*Room.tsx": [
        "exports"
      ],
      "packages/kit/src/client/devtoolsEventClient.js": [
        "exports"
      ],
      "packages/mistri/src/client/ssr/render.tsx": [
        "exports",
        "types"
      ],
      "packages/engine/src/shared/{appLinks,theme,page,pageModel,recordview,view,computed,appComponents}.ts": [
        "types"
      ],
      "packages/mistri/src/shared/{command,branding,appApi}.ts": [
        "types"
      ],
      "packages/engine/src/adapters/adapter.ts": [
        "types"
      ],
      "packages/mistri/src/client/components/sdk/hooks.ts": [
        "types"
      ],
      "packages/mistri/src/client/components/console/model.ts": [
        "types"
      ],
      "packages/mistri/src/server/commands/{businessCommandExecution,commandDb}.ts": [
        "types"
      ],
      "packages/mistri/src/server/flags/authority.ts": [
        "types"
      ],
      "packages/mistri/src/shared/appProvenance.ts": [
        "exports"
      ],
      "packages/mistri/src/shared/preview.ts": [
        "exports"
      ],
      "scripts/soak/k6/mixed.js": [
        "unlisted"
      ],
      "packages/mistri/src/shared/tenantHttp.ts": [
        "types"
      ],
      "packages/mistri/src/server/console/components.ts": [
        "exports"
      ]
    }
  }
}
