{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    /* commands.ts imports `@mistriwork/mistri/commands` the way a deployment writes it.
       The package's exports map types that from dist/, which a fresh checkout
       has not built; this mirrors the root tsconfig and reads the source. */
    "paths": {
      "@mistriwork/mistri/commands": ["../../../../packages/mistri/src/server/commands.ts"]
    }
  },
  "include": ["**/*.ts", "pages/*.page.tsx", "widgets/*.tsx"]
}
